#| label: setup
#| include: false
library(Bergm.ws)
options(width = 90)
#| label: data
data(toy_ws)
w <- toy_ws$weights
t_k <- toy_ws$thresholds
z <- toy_ws$signs
y <- ws_data(w, t_k, z); y
#| label: network
#| fig-width: 8
#| fig-height: 7.5
xy <- ws_layout(y)
plot(y, layout = xy)
#| label: model
s <- ~ # layer 1
L(~edges, ~(z & x_1)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_1)) +
L(~edges, ~(!z & x_1)) +
# layer 2
L(~edges, ~(z & x_2)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_2)) +
L(~edges, ~(!z & x_2)) +
# layer 3
L(~edges, ~(z & x_3)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_3)) +
L(~edges, ~(!z & x_3))
model <- ws_model(y, s)
model
#| label: prior
prior <- ws_prior(model,
mu0 = 0,
Sigma0 = 3,
nu0 = model$p + 9,
S0 = 1)
prior
#| label: prior-pred
#| fig-width: 7.5
#| fig-height: 7
y_prior <- ws_predictive(model,
prior = prior,
type = "prior",
nsim = 100,
seed = 1,
verbose = FALSE)
plot(y_prior)
#| label: prior-out
#| include: false
pt <- Bergm.ws:::.pred_table(y_prior$stats, y_prior$obs)
prior_text <- if (any(pt$outside == "*")) {
paste0("Some observed statistics lie outside the central 95% of the prior ",
"predictive distribution: ", paste(rownames(pt)[pt$outside == "*"], collapse = ", "),
"; a more informative prior may be worth considering.")
} else {
"Every observed statistic lies inside the central 95% of the prior predictive distribution: the prior is weakly informative on the scale of the data."
}
#| label: fit
post <- bergm_ws(model,
prior = prior,
n_iter = 15000,
burnin = 1500,
n_chains = 3,
cores = 2,
seed = 2026,
verbose = FALSE)
