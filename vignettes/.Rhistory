#| label: setup
#| include: false
library(Bergm.ws)
options(width = 90)
#| label: data
data(toy_ws)
w <- toy_ws$weights
t_k <- toy_ws$thresholds
z <- toy_ws$signs
y <- ws_data(w, t_k, z); y
#| label: network
#| fig-width: 8
#| fig-height: 7.5
xy <- ws_layout(y)
plot(y, layout = xy)
#| label: model
s <- ~ # layer 1
L(~edges, ~(z & x_1)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_1)) +
L(~edges, ~(!z & x_1)) +
# layer 2
L(~edges, ~(z & x_2)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_2)) +
L(~edges, ~(!z & x_2)) +
# layer 3
L(~edges, ~(z & x_3)) +
L(~gwdegree(0.5, fixed = TRUE), ~(z & x_3)) +
L(~edges, ~(!z & x_3))
model <- ws_model(y, s)
model
#| label: prior
prior <- ws_prior(model,
mu0 = 0,
Sigma0 = 3,
nu0 = model$p + 9,
S0 = 1)
prior
#| label: prior-pred
#| fig-width: 7.5
#| fig-height: 7
y_prior <- ws_predictive(model,
prior = prior,
type = "prior",
nsim = 100,
seed = 1,
verbose = FALSE)
plot(y_prior)
#| label: prior-out
#| include: false
pt <- Bergm.ws:::.pred_table(y_prior$stats, y_prior$obs)
prior_text <- if (any(pt$outside == "*")) {
paste0("Some observed statistics lie outside the central 95% of the prior ",
"predictive distribution: ", paste(rownames(pt)[pt$outside == "*"], collapse = ", "),
"; a more informative prior may be worth considering.")
} else {
"Every observed statistic lies inside the central 95% of the prior predictive distribution: the prior is weakly informative on the scale of the data."
}
#| label: fit
post <- bergm_ws(model,
prior = prior,
n_iter = 15,
burnin = 1,
n_chains = 3,
cores = 2,
seed = 2026,
verbose = FALSE)
#| label: summary
summary_post <- summary(post)
summary_post
#| label: conv
#| include: false
rmax <- max(c(summary_post$phi$Rhat, summary_post$mu$Rhat))
emin <- min(c(summary_post$phi$ESS, summary_post$mu$ESS))
conv_text <- if (rmax < 1.05 && emin >= 100) {
"which is adequate for this example."
} else {
"so longer chains (larger `n_iter`) would be needed for a final analysis."
}
#| label: coef
phi <- coef(post)
mu <- coef(post, what = "mu")
round(phi, 2)
round(mu, 2)
#| label: intervals
#| fig-width: 8
#| fig-height: 5.5
plot(post, type = "intervals")
#| label: traces
#| fig-width: 10
#| fig-height: 6.5
plot(post, max_points = 500)
#| label: post-pred
#| fig-width: 7.5
#| fig-height: 7.5
y_rep <- ws_predictive(post, nsim = 200, seed = 2, verbose = FALSE)
par(mfrow = c(1, 2))
plot(y_rep, what = "model")
plot(y_rep, what = "gof")
library(Bergm.ws)
library(coda)
out_file <- "vignette_results.rds"
cores <- 2
data(toy_ws)
y <- ws_data(toy_ws$weights, toy_ws$thresholds, toy_ws$signs, toy_ws$attributes)
s <- ~ L(~edges, ~(z & x_k)) + L(~nodematch("pathway"), ~(z & x_k)) + L(~edges, ~(!z & x_k)) +
gwespL(0.5, fixed = TRUE, L.base = ~(z & x_k), Ls.path = list(~(z & x_k), ~(z & x_k))) +
gwespL(0.5, fixed = TRUE, L.base = ~(!z & x_k), Ls.path = list(~(z & x_k), ~(z & x_k)))
model <- ws_model(y, s, scale = "gwesp")
prior <- ws_prior(model)
configs <- list(
basic = list(delayed = FALSE, collapse_mu = FALSE, pool_adaptation = FALSE),
`+ delayed acceptance` = list(delayed = TRUE, collapse_mu = FALSE, pool_adaptation = FALSE),
`+ mu integrated out` = list(delayed = TRUE, collapse_mu = TRUE, pool_adaptation = FALSE),
`+ pooled adaptation` = list(delayed = TRUE, collapse_mu = TRUE, pool_adaptation = TRUE))
rows <- list()
for (seed in c(11, 12)) for (nm in names(configs)) {
post <- do.call(bergm_ws, c(list(model, prior = prior, n_iter = 10000, burnin = 1000, n_chains = 4,
cores = cores, seed = seed, verbose = FALSE), configs[[nm]]))
sp <- summary(post)
ess <- c(sp$phi$ESS, sp$mu$ESS)
rows[[length(rows) + 1]] <- data.frame(
sampler = nm, seed = seed, seconds = post$elapsed, simulated = sp$sim_share,
acceptance = mean(sp$acceptance), median_ESS = median(ess), min_ESS = min(ess),
max_Rhat = max(c(sp$phi$Rhat, sp$mu$Rhat)), ESS_per_minute = 60 * median(ess) / post$elapsed)
}
